# ==============================================================================
# Unified Cloud Run Nginx Configuration Template (`nginx.conf.template`)
# Dynamic port ${PORT} substituted at container boot by docker-entrypoint.sh
# ==============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Security & MIME headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Gzip compression for JS, CSS, JSON, and VRM/GLTF 3D assets
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        model/gltf-binary
        application/octet-stream;

    # 1. REST API Reverse Proxy (`/api/v1/...` -> `http://127.0.0.1:8000/api/v1/...`)
    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    # 2. Hybrid WebSocket Relay Proxy (`/ws/interview/{session_id}`)
    # Supports up to 60-minute continuous full-duplex 16kHz/24kHz PCM audio streaming
    location /ws/interview/ {
        proxy_pass http://127.0.0.1:8000/ws/interview/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 3. Static Assets & 3D VRM Models Cache Policy
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|gif|svg|ico|vrm|glb)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }

    # 4. React Router SPA Fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ==============================================================================
# Backend FastAPI Configuration (`backend/.env.example`)
# ==============================================================================
# Copy to `backend/.env` for local backend development.

APP_NAME="Real-Time AI Interviewer Backend"
APP_VERSION="1.0.0"
ENVIRONMENT="development"

# Async SQLAlchemy Database URL:
# - Local SQLite (zero-dependency dev): sqlite+aiosqlite:///./ai_interviewer.db
# - Production PostgreSQL 16 (asyncpg): postgresql+asyncpg://interviewer:interviewer_secret_password@localhost:5432/ai_interviewer
DATABASE_URL="sqlite+aiosqlite:///./ai_interviewer.db"

# Ephemeral Candidate JWT signing key (>= 32 bytes recommended)
JWT_SECRET="dev-ephemeral-jwt-secret-key-change-in-production-32b"
JWT_ALGORITHM="HS256"

# Google Gemini / Vertex AI Configuration (Server-Side Isolated ONLY):
# Enable GOOGLE_GENAI_USE_VERTEXAI=true with `gcloud auth application-default login`
# or set `GEMINI_API_KEY` for Google AI Studio.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT="dev-nixon-daniel"
GOOGLE_CLOUD_LOCATION="us-central1"
GEMINI_API_KEY=""
GEMINI_LIVE_MODEL="gemini-live-2.5-flash-native-audio"
GEMINI_EVALUATOR_MODEL="gemini-2.5-flash"

# Billing & Token Cost Guardrails (ADR-004)
LIVE_MAX_SESSION_DURATION_SEC=300
LIVE_VAD_RMS_THRESHOLD=0.006
LIVE_VAD_HANGOVER_CHUNKS=20

# Allowed CORS Origins for Browser Frontend
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173","http://localhost:8080","http://127.0.0.1:8080"]

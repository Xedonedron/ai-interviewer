# ==============================================================================
# Frontend Configuration (`frontend/.env.example`)
# ==============================================================================
# SECURITY GUARDRAIL: NEVER put `GEMINI_API_KEY` or `JWT_SECRET_KEY` in this file.
# All `VITE_*` variables are statically embedded into the public browser bundle.

# Base URL for REST API calls (`/api/v1/...`).
# Leave empty (`""`) to use same-origin relative paths (Vite dev proxy or Nginx reverse proxy).
VITE_API_BASE_URL=

# Base URL for WebSocket connections (`/ws/interview/{session_id}`).
# Leave empty (`""`) to auto-resolve `ws://<window.location.host>` or `wss://<window.location.host>`.
VITE_WS_BASE_URL=

# Dual-Mode Switch:
# - `false` (default for Phase 4): Connects to the live FastAPI backend (`/api` & `/ws`),
#   with automatic graceful fallback if the backend is offline or when `?mock=true` is in the URL.
# - `true`: Forces Standalone Client-Side Simulator Mode (24kHz Formant Synth + Mock Fixtures).
VITE_USE_MOCK_SIMULATOR=false

# Target backend URL used by `vite.config.ts` dev server proxy (`npm run dev`).
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8010

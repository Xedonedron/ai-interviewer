# ==============================================================================
# Real-Time AI Interviewer Platform — Root Docker Compose & System Environment
# ==============================================================================
# Copy to `.env` before running `docker compose up --build`.
# SECURITY GUARDRAIL: `GEMINI_API_KEY` is strictly isolated in the backend
# container and MUST NEVER be prefixed with `VITE_` or exposed to the frontend.

# --- PostgreSQL 16 Database ---
POSTGRES_USER=interviewer
POSTGRES_PASSWORD=interviewer_secret_password
POSTGRES_DB=ai_interviewer
POSTGRES_PORT=5432

# --- Backend FastAPI Relay & Evaluation Engine ---
APP_ENV=production
DATABASE_URL=postgresql+asyncpg://interviewer:interviewer_secret_password@postgres:5432/ai_interviewer
JWT_SECRET_KEY=replace-with-at-least-32-bytes-hmac-sha256-secret-key-prod
JWT_ALGORITHM=HS256

# Leave empty to run backend in deterministic Local Live / Evaluation Simulation Mode,
# or provide a valid Google Gemini API key for upstream Gemini Live 2.5 Native Audio & 2.5 Pro Evaluation.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_EVAL_MODEL=gemini-2.5-pro

CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","http://127.0.0.1:5173","http://127.0.0.1:8080"]
BACKEND_PORT=8000

# --- Frontend Nginx / Vite Configuration ---
FRONTEND_PORT=8080
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_USE_MOCK_SIMULATOR=false
